{
  "name": "finger-light",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "prepare:assets": "node scripts/prepare-assets.mjs",
    "build:worker": "node scripts/build-worker.mjs",
    "predev": "npm run build:worker",
    "prebuild": "npm run build:worker",
    "format": "prettier --write src tests scripts *.ts *.js *.json index.html",
    "test:perf": "RUN_PERF=1 playwright test --grep 5\u5206\u949f",
    "test:e2e:build": "TEST_BUILD=1 playwright test"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "0.10.32",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.13.4",
    "@types/three": "^0.180.0",
    "esbuild": "0.28.2",
    "eslint": "^9.39.0",
    "globals": "^16.5.0",
    "prettier": "3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.1.12",
    "vitest": "^4.1.11"
  }
}
